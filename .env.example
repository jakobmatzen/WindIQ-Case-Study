# Copy to .env.local for local development (points at your Supabase DEV project).

# Supabase Dashboard -> Connect -> "Session pooler" connection string (port 5432).
DATABASE_URL=postgresql://postgres.<dev-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# WindIQ Mock-API (credentials from the case study PDF, never commit)
WINDIQ_API_BASE_URL=https://windiq-mock-api.sliplane.app
WINDIQ_CLIENT_ID=wiq_xxx
WINDIQ_CLIENT_SECRET=xxx

# Optional
# SYNC_INTERVAL_MS=900000
# HEALTH_MAX_SYNC_AGE_MINUTES=120
